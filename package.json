{
  "name": "choralith-audio-explorer",
  "productName": "Choralith Audio Explorer",
  "version": "1.3.2",
  "main": "electron/main.js",
  "author": "Stefano Mercadante <stefmercadante@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^28.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "music-metadata": "^7.14.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "build": {
    "appId": "com.stesproject.choralith",
    "productName": "Choralith Audio Explorer",
    "files": [
      "dist",
      "electron"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "asar": true,
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/icons/png",
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "assets/icons"
      }
    ]
  }
}
